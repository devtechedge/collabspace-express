# CollabSpace backend environment variables
# Copy this file to .env and fill in your values.

# Port for the Express server (default: 5000)
PORT=5000

# Database URL for Prisma (SQLite for local dev; swap to postgres:// for production)
# SQLite (local):
DATABASE_URL="file:./prisma/dev.db"
# PostgreSQL (production example):
# DATABASE_URL="postgresql://user:password@host:5432/collabspace"

# CORS origin — set to your frontend URL in production
# (default allows all origins for local dev)
CORS_ORIGIN=*
