# Port for the Express + Socket.io server (default: 5000)
PORT=5000

# Prisma SQLite file is configured in prisma/schema.prisma.
# Swap the provider to postgresql and set DATABASE_URL for a hosted database.
# DATABASE_URL="file:./prisma/dev.db"

# CORS origin — lock this to the frontend origin in any public bind.
# Default * is local-dev only and is documented as residual risk in SECURITY.md.
CORS_ORIGIN=*
